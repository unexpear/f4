#version 430 core

#ifdef F4_VULKAN
layout(std430, set = 0, binding = 3) buffer Outputs { float values[]; } outputBuffer;
#else
layout(std430, binding = 0) buffer Outputs { float values[]; } outputBuffer;
#endif

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

const uvec2 kGoldenGamma = uvec2(0x7f4a7c15u, 0x9e3779b9u);
const uvec2 kMixM1 = uvec2(0x1ce4e5b9u, 0xbf58476du);
const uvec2 kMixM2 = uvec2(0x133111ebu, 0x94d049bbu);
const uvec2 kYMultiplier = uvec2(0x27220a95u, 0x517cc1b7u);

uvec2 add64(uvec2 a, uvec2 b) {
    uint low = a.x + b.x;
    return uvec2(low, a.y + b.y + uint(low < a.x));
}

uvec2 xor64(uvec2 a, uvec2 b) { return a ^ b; }

uvec2 shiftRight64(uvec2 value, uint bits) {
    return uvec2((value.x >> bits) | (value.y << (32u - bits)), value.y >> bits);
}

uvec2 shiftLeft64(uvec2 value, uint bits) {
    if (bits == 32u) return uvec2(0u, value.x);
    if (bits > 32u) return uvec2(0u, value.x << (bits - 32u));
    return uvec2(value.x << bits, (value.y << bits) | (value.x >> (32u - bits)));
}

uvec2 multiply64(uvec2 a, uvec2 b) {
    uint a0 = a.x & 0xffffu;
    uint a1 = a.x >> 16u;
    uint b0 = b.x & 0xffffu;
    uint b1 = b.x >> 16u;
    uint p0 = a0 * b0;
    uint p1 = a0 * b1;
    uint p2 = a1 * b0;
    uint p3 = a1 * b1;
    uint middle = (p0 >> 16u) + (p1 & 0xffffu) + (p2 & 0xffffu);
    uint low = (p0 & 0xffffu) | (middle << 16u);
    uint high = p3 + (p1 >> 16u) + (p2 >> 16u) + (middle >> 16u);
    high += (a.x * b.y) + (a.y * b.x);
    return uvec2(low, high);
}

uvec2 fromInt(int value) {
    return uvec2(uint(value), value < 0 ? 0xffffffffu : 0u);
}

uvec2 mix64(uvec2 value) {
    value = add64(value, kGoldenGamma);
    value = multiply64(xor64(value, shiftRight64(value, 30u)), kMixM1);
    value = multiply64(xor64(value, shiftRight64(value, 27u)), kMixM2);
    return xor64(value, shiftRight64(value, 31u));
}

uvec2 hash64(uvec2 lattice, uvec2 seed) {
    return mix64(xor64(lattice, mix64(seed)));
}

float unitFromHash(uvec2 hash) {
    return float(hash.y >> 8u) * (1.0 / 16777216.0);
}

float fadeNoise(float t) { return (t * t) * (3.0 - 2.0 * t); }
float lerpNoise(float a, float b, float t) { return a + ((b - a) * t); }

vec2 grad2(uint index) {
    switch (index & 7u) {
    case 0u: return vec2(1.0, 0.0);
    case 1u: return vec2(-1.0, 0.0);
    case 2u: return vec2(0.0, 1.0);
    case 3u: return vec2(0.0, -1.0);
    case 4u: return vec2(0.70710678118654752, 0.70710678118654752);
    case 5u: return vec2(-0.70710678118654752, 0.70710678118654752);
    case 6u: return vec2(0.70710678118654752, -0.70710678118654752);
    default: return vec2(-0.70710678118654752, -0.70710678118654752);
    }
}

vec3 grad3(uint index) {
    switch (index) {
    case 0u: return vec3(1.0, 1.0, 0.0);
    case 1u: return vec3(-1.0, 1.0, 0.0);
    case 2u: return vec3(1.0, -1.0, 0.0);
    case 3u: return vec3(-1.0, -1.0, 0.0);
    case 4u: return vec3(1.0, 0.0, 1.0);
    case 5u: return vec3(-1.0, 0.0, 1.0);
    case 6u: return vec3(1.0, 0.0, -1.0);
    case 7u: return vec3(-1.0, 0.0, -1.0);
    case 8u: return vec3(0.0, 1.0, 1.0);
    case 9u: return vec3(0.0, -1.0, 1.0);
    case 10u: return vec3(0.0, 1.0, -1.0);
    default: return vec3(0.0, -1.0, -1.0);
    }
}

uint mod12(uvec2 value) {
    return (((value.y % 12u) * 4u) + (value.x % 12u)) % 12u;
}

float value2D(float x, float y, uvec2 seed) {
    int xi = int(floor(x));
    int yi = int(floor(y));
    float fx = x - float(xi);
    float fy = y - float(yi);
    uvec2 row0 = xor64(seed, multiply64(fromInt(yi), kYMultiplier));
    uvec2 row1 = xor64(seed, multiply64(fromInt(yi + 1), kYMultiplier));
    float v00 = unitFromHash(hash64(fromInt(xi), row0)) * 2.0 - 1.0;
    float v10 = unitFromHash(hash64(fromInt(xi + 1), row0)) * 2.0 - 1.0;
    float v01 = unitFromHash(hash64(fromInt(xi), row1)) * 2.0 - 1.0;
    float v11 = unitFromHash(hash64(fromInt(xi + 1), row1)) * 2.0 - 1.0;
    float sx = fadeNoise(fx);
    float sy = fadeNoise(fy);
    return lerpNoise(lerpNoise(v00, v10, sx), lerpNoise(v01, v11, sx), sy);
}

uvec2 lattice3(int x, int y, int z) {
    return xor64(xor64(fromInt(x), shiftLeft64(fromInt(y), 21u)),
                 shiftLeft64(fromInt(z), 42u));
}

float valueCorner3(int x, int y, int z, uvec2 seed) {
    return unitFromHash(hash64(lattice3(x, y, z), seed)) * 2.0 - 1.0;
}

float value3D(float x, float y, float z, uvec2 seed) {
    int xi = int(floor(x));
    int yi = int(floor(y));
    int zi = int(floor(z));
    float sx = fadeNoise(x - float(xi));
    float sy = fadeNoise(y - float(yi));
    float sz = fadeNoise(z - float(zi));
    float x00 = lerpNoise(valueCorner3(xi, yi, zi, seed),
                          valueCorner3(xi + 1, yi, zi, seed), sx);
    float x10 = lerpNoise(valueCorner3(xi, yi + 1, zi, seed),
                          valueCorner3(xi + 1, yi + 1, zi, seed), sx);
    float x01 = lerpNoise(valueCorner3(xi, yi, zi + 1, seed),
                          valueCorner3(xi + 1, yi, zi + 1, seed), sx);
    float x11 = lerpNoise(valueCorner3(xi, yi + 1, zi + 1, seed),
                          valueCorner3(xi + 1, yi + 1, zi + 1, seed), sx);
    return lerpNoise(lerpNoise(x00, x10, sy), lerpNoise(x01, x11, sy), sz);
}

float perlinCorner2(int x, int y, float dx, float dy, uvec2 seed) {
    uvec2 lattice = xor64(fromInt(x), shiftLeft64(fromInt(y), 32u));
    vec2 gradient = grad2(hash64(lattice, seed).x);
    return gradient.x * dx + gradient.y * dy;
}

float perlin2D(float x, float y, uvec2 seed) {
    int xi = int(floor(x));
    int yi = int(floor(y));
    float fx = x - float(xi);
    float fy = y - float(yi);
    float sx = fadeNoise(fx);
    float sy = fadeNoise(fy);
    float n00 = perlinCorner2(xi, yi, fx, fy, seed);
    float n10 = perlinCorner2(xi + 1, yi, fx - 1.0, fy, seed);
    float n01 = perlinCorner2(xi, yi + 1, fx, fy - 1.0, seed);
    float n11 = perlinCorner2(xi + 1, yi + 1, fx - 1.0, fy - 1.0, seed);
    return lerpNoise(lerpNoise(n00, n10, sx), lerpNoise(n01, n11, sx), sy);
}

float perlinCorner3(int x, int y, int z, float dx, float dy, float dz, uvec2 seed) {
    vec3 gradient = grad3(mod12(hash64(lattice3(x, y, z), seed)));
    return gradient.x * dx + gradient.y * dy + gradient.z * dz;
}

float perlin3D(float x, float y, float z, uvec2 seed) {
    int xi = int(floor(x));
    int yi = int(floor(y));
    int zi = int(floor(z));
    float fx = x - float(xi);
    float fy = y - float(yi);
    float fz = z - float(zi);
    float sx = fadeNoise(fx);
    float sy = fadeNoise(fy);
    float sz = fadeNoise(fz);
    float n000 = perlinCorner3(xi, yi, zi, fx, fy, fz, seed);
    float n100 = perlinCorner3(xi + 1, yi, zi, fx - 1.0, fy, fz, seed);
    float n010 = perlinCorner3(xi, yi + 1, zi, fx, fy - 1.0, fz, seed);
    float n110 = perlinCorner3(xi + 1, yi + 1, zi, fx - 1.0, fy - 1.0, fz, seed);
    float n001 = perlinCorner3(xi, yi, zi + 1, fx, fy, fz - 1.0, seed);
    float n101 = perlinCorner3(xi + 1, yi, zi + 1, fx - 1.0, fy, fz - 1.0, seed);
    float n011 = perlinCorner3(xi, yi + 1, zi + 1, fx, fy - 1.0, fz - 1.0, seed);
    float n111 = perlinCorner3(xi + 1, yi + 1, zi + 1, fx - 1.0, fy - 1.0,
                               fz - 1.0, seed);
    float x00 = lerpNoise(n000, n100, sx);
    float x10 = lerpNoise(n010, n110, sx);
    float x01 = lerpNoise(n001, n101, sx);
    float x11 = lerpNoise(n011, n111, sx);
    return lerpNoise(lerpNoise(x00, x10, sy), lerpNoise(x01, x11, sy), sz);
}

float simplexCorner(int i, int j, float dx, float dy, uvec2 seed) {
    float t = 0.5 - dx * dx - dy * dy;
    if (t < 0.0) return 0.0;
    uvec2 lattice = xor64(fromInt(i), shiftLeft64(fromInt(j), 32u));
    vec2 gradient = grad2(hash64(lattice, seed).x);
    float t4 = (t * t) * (t * t);
    return t4 * (gradient.x * dx + gradient.y * dy);
}

float simplex2D(float x, float y, uvec2 seed) {
    const float f2 = 0.36602540378443865;
    const float g2 = 0.21132486540518713;
    float s = (x + y) * f2;
    int i = int(floor(x + s));
    int j = int(floor(y + s));
    float t = (float(i) + float(j)) * g2;
    float x0 = x - (float(i) - t);
    float y0 = y - (float(j) - t);
    int i1 = x0 > y0 ? 1 : 0;
    int j1 = x0 > y0 ? 0 : 1;
    float x1 = x0 - float(i1) + g2;
    float y1 = y0 - float(j1) + g2;
    float x2 = x0 - 1.0 + 2.0 * g2;
    float y2 = y0 - 1.0 + 2.0 * g2;
    return 70.0 * (simplexCorner(i, j, x0, y0, seed) +
                   simplexCorner(i + i1, j + j1, x1, y1, seed) +
                   simplexCorner(i + 1, j + 1, x2, y2, seed));
}

uvec2 octaveSeed(uvec2 seed, int octave) {
    return xor64(seed, multiply64(uvec2(uint(octave), 0u), kGoldenGamma));
}

float fbm2D(float x, float y, uvec2 seed) {
    float sum = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    float normalization = 0.0;
    for (int octave = 0; octave < 4; ++octave) {
        sum += amplitude * perlin2D(x * frequency, y * frequency,
                                    octaveSeed(seed, octave));
        normalization += amplitude;
        amplitude *= 0.5;
        frequency *= 2.0;
    }
    return sum / normalization;
}

float fbm3D(float x, float y, float z, uvec2 seed) {
    float sum = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    float normalization = 0.0;
    for (int octave = 0; octave < 4; ++octave) {
        sum += amplitude * perlin3D(x * frequency, y * frequency, z * frequency,
                                    octaveSeed(seed, octave));
        normalization += amplitude;
        amplitude *= 0.5;
        frequency *= 2.0;
    }
    return sum / normalization;
}

uvec2 sampleSeed(uint index) {
    if (index == 0u) return uvec2(0u, 0u);
    if (index == 1u) return uvec2(1u, 0u);
    if (index == 2u) return uvec2(0x89abcdefu, 0x01234567u);
    return uvec2(0x76543210u, 0xfedcba98u);
}

vec3 samplePoint(uint index) {
    if (index == 0u) return vec3(0.125, -0.75, 1.5);
    if (index == 1u) return vec3(-13.25, 7.875, -2.5);
    if (index == 2u) return vec3(1024.125, -2048.75, 0.03125);
    return vec3(-0.001, 0.999, 42.25);
}

void main() {
    uint sampleIndex = gl_GlobalInvocationID.x;
    if (sampleIndex >= 4u) return;
    vec3 point = samplePoint(sampleIndex);
    uvec2 seed = sampleSeed(sampleIndex);
    uint base = sampleIndex * 9u;
    outputBuffer.values[base + 0u] = value2D(point.x, point.y, seed);
    outputBuffer.values[base + 1u] = value3D(point.x, point.y, point.z, seed);
    outputBuffer.values[base + 2u] = perlin2D(point.x, point.y, seed);
    outputBuffer.values[base + 3u] = perlin3D(point.x, point.y, point.z, seed);
    outputBuffer.values[base + 4u] = simplex2D(point.x, point.y, seed);
    outputBuffer.values[base + 5u] = fbm2D(point.x, point.y, seed);
    outputBuffer.values[base + 6u] = fbm3D(point.x, point.y, point.z, seed);
    outputBuffer.values[base + 7u] = perlin2D(point.x, point.y,
        xor64(seed, uvec2(0x79b97f4au, 0xa1539e37u))) * 2.75;
    outputBuffer.values[base + 8u] = perlin2D(point.x, point.y,
        xor64(seed, uvec2(0x476d1ce4u, 0x8f35bf58u))) * 2.75;
}
