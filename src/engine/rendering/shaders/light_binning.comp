#version 430 core

// Clustered point-light binning on the GPU (see clustered_lights.h).
//
// The CPU culls the lights, computes each visible light's cluster box, and
// derives every cluster's light count from the boxes with a 3D difference
// array (O(lights + clusters)), so it uploads the finished buffer prefix:
// header, light records, shadow matrices, and the cluster records (list
// offset, count; capped to maxIndexCount in cluster order like the CPU path).
// After the prefix come per-axis light masks: one bit per visible light for
// every tile column, tile row, and depth slice the light's box covers. A
// light lies in cluster (x, y, z) exactly when its bit is set in column x,
// row y and slice z, so ANDing three mask words tests 32 lights at once.
//
// One dispatch: thread i copies prefix word i, and thread c < clusterCount
// writes cluster c's light list by walking the ANDed mask words lowest bit
// first, i.e. in ascending light order. The output is word-for-word the CPU
// layout. One source serves OpenGL (SSBO bindings 0/1) and Vulkan
// (-DF4_VULKAN=1, storage slots 0/1 flatten to bindings 3/7).

#ifdef F4_VULKAN
layout(set = 0, binding = 0, std140) uniform BinParams {
    uvec4 counts;  // clusterCount, visible, copyWords, maskWords
    uvec4 offsets; // maskOffset, gridOffset, 0, 0
    uvec4 grid;    // tilesX, tilesY, slices, 0
} params;
layout(set = 0, binding = 3, std430) readonly buffer BinInput { uint words[]; } src;
layout(set = 0, binding = 7, std430) writeonly buffer BinOutput { uint words[]; } dst;
#else
layout(std140, binding = 0) uniform BinParams {
    uvec4 counts;
    uvec4 offsets;
    uvec4 grid;
} params;
layout(std430, binding = 0) readonly buffer BinInput { uint words[]; } src;
layout(std430, binding = 1) writeonly buffer BinOutput { uint words[]; } dst;
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id < params.counts.z) dst.words[id] = src.words[id];
    uint clusterCount = params.counts.x;
    if (id >= clusterCount) return;
    uint gridOffset = params.offsets.y;
    uint first = src.words[gridOffset + id * 2u];
    uint allowed = src.words[gridOffset + id * 2u + 1u];
    if (allowed == 0u) return;
    uint maskWords = params.counts.w;
    uint tilesX = params.grid.x;
    uint tilesY = params.grid.y;
    uint x = id % tilesX;
    uint y = (id / tilesX) % tilesY;
    uint z = id / (tilesX * tilesY);
    uint rowX = params.offsets.x + x * maskWords;
    uint rowY = params.offsets.x + (tilesX + y) * maskWords;
    uint rowZ = params.offsets.x + (tilesX + tilesY + z) * maskWords;
    uint written = 0u;
    for (uint word = 0u; word < maskWords && written < allowed; ++word) {
        uint bits = src.words[rowX + word] & src.words[rowY + word] & src.words[rowZ + word];
        while (bits != 0u && written < allowed) {
            uint bit = uint(findLSB(bits));
            dst.words[first + written] = word * 32u + bit;
            ++written;
            bits &= bits - 1u;
        }
    }
}
