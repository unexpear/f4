cmake_minimum_required(VERSION 3.29)
if(NOT EXISTS "${DEMO}" OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Set DEMO to f4_streaming_demo and OUTPUT_DIR to the capture parent")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(root "${OUTPUT_DIR}/${run_id}")
file(MAKE_DIRECTORY "${root}")
set(checkpoints 00_home 01_edited 02_away 03_returned 04_reloaded)
foreach(run RANGE 1 2)
    execute_process(COMMAND "${DEMO}" --verify --output "${root}/run-${run}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 150)
    file(WRITE "${root}/run-${run}.log" "${stdout}\n${stderr}")
    if(NOT result STREQUAL "0" OR NOT stdout MATCHES "PASS: 25 CPU/GPU chunks")
        message(FATAL_ERROR "Streaming demo failed (${result}):\n${stdout}\n${stderr}")
    endif()
    file(GLOB images "${root}/run-${run}/*.bmp")
    list(LENGTH images count)
    if(NOT count EQUAL 18)
        message(FATAL_ERROR "Expected 10 settled and 8 moving captures; found ${count}")
    endif()
    foreach(checkpoint IN LISTS checkpoints)
        file(SHA256 "${root}/run-${run}/${checkpoint}.bmp" original)
        file(SHA256 "${root}/run-${run}/${checkpoint}_repeat.bmp" repeated)
        if(NOT original STREQUAL repeated)
            message(FATAL_ERROR "Checkpoint blinks: ${checkpoint}")
        endif()
    endforeach()
endforeach()
foreach(checkpoint IN LISTS checkpoints)
    file(SHA256 "${root}/run-1/${checkpoint}.bmp" original)
    file(SHA256 "${root}/run-2/${checkpoint}.bmp" repeated)
    if(NOT original STREQUAL repeated)
        message(FATAL_ERROR "Settled capture differs across processes: ${checkpoint}")
    endif()
endforeach()

# Never accept stale output, and reject invalid save data before creating a window.
execute_process(COMMAND "${DEMO}" --verify --load "${root}/run-1/world.f4sd" --output "${root}/load-run"
    RESULT_VARIABLE loaded OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
if(NOT loaded STREQUAL "0" OR NOT stdout MATCHES "PASS: separate-process")
    message(FATAL_ERROR "Separate-process load failed: ${stdout}\n${stderr}")
endif()
file(SHA256 "${root}/run-1/01_edited.bmp" edited)
file(SHA256 "${root}/load-run/loaded.bmp" restored)
file(SHA256 "${root}/load-run/loaded_repeat.bmp" restored_repeat)
if(NOT edited STREQUAL restored OR NOT restored STREQUAL restored_repeat)
    message(FATAL_ERROR "Separate-process restored image differs from the saved world")
endif()

execute_process(COMMAND "${DEMO}" --verify --output "${root}/run-1"
    RESULT_VARIABLE existing OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
if(NOT existing STREQUAL "1")
    message(FATAL_ERROR "Existing output was not rejected")
endif()
file(WRITE "${root}/invalid.f4sd" "invalid")
execute_process(COMMAND "${DEMO}" --load "${root}/invalid.f4sd" --output "${root}/invalid-run"
    RESULT_VARIABLE corrupt OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
if(NOT corrupt STREQUAL "1" OR EXISTS "${root}/invalid-run")
    message(FATAL_ERROR "Corrupt save was not rejected before initialization")
endif()
file(WRITE "${root}/index.html" "<!doctype html><html lang='en'><meta charset='utf-8'>
<meta name='viewport' content='width=device-width,initial-scale=1'><title>M16 streaming world</title>
<style>body{margin:28px;background:#e9e4d8;color:#182c2b;font-family:Georgia,serif}
main{display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:18px}
figure{margin:0;padding:12px;background:#fffdf5}img{width:100%}figcaption{font-family:monospace}</style>
<h1>M16 streaming world</h1><p>25 streamed height chunks, production forward renderer, edit/unload/disk-reload checks.
Settled views repeat exactly. Moving views are diagnostic samples, not deterministic frame-time gates.</p><main>")
file(GLOB first_images RELATIVE "${root}/run-1" "${root}/run-1/*.bmp")
foreach(relative IN LISTS first_images)
    if(NOT relative MATCHES "_repeat")
        file(APPEND "${root}/index.html" "<figure><a href='run-1/${relative}'><img src='run-1/${relative}' alt='${relative}'></a><figcaption>${relative}</figcaption></figure>\n")
    endif()
endforeach()
file(APPEND "${root}/index.html" "</main></html>")
message(STATUS "Streaming demo passed: repeatable checkpoints, moving residency, edit/save/reload and GPU lifetime checks.")
message(STATUS "Gallery: ${root}/index.html")
